{
  "$schema": "https://opencode.ai/config.json",
  // Communication policy: keep assistant tone neutral and non-sycophantic.
  "default_agent": "plan",
  // Share the Claude Code global rules; OpenCode keeps no copy of its own.
  "instructions": ["~/.claude/CLAUDE.md"],
  // Rules are evaluated in order and the last match wins.
  "permissions": [
    // Skills and workstream files live outside the project directory.
    { "action": "external_directory", "resource": "~/.claude/*", "effect": "allow" },
    { "action": "read", "resource": "~/.claude/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.llm-workstreams/*", "effect": "allow" },
    { "action": "read", "resource": "~/.llm-workstreams/*", "effect": "allow" },
  ],
  "agents": {
    "plan": {
      "color": "#b8bb26",
    },
    "build": {
      "color": "#fb4934",
    },
  },
  "plugins": [],
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "node:22-alpine",
          "npx",
          "-y",
          "@upstash/context7-mcp",
        ],
        "disabled": false,
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": ["codebase-memory-mcp"],
        "disabled": false,
      },
    },
  },
}
