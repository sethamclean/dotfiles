[user]
	name = Seth McLean
	email = 379763+sethamclean@users.noreply.github.com

[alias]
	tree = log --oneline --graph --color --all --decorate
	d = difftool
	status-report = !git --no-pager diff --stat && git --no-pager status -s

[core]
	editor = nvim
	excludesfile = ~/.gitignore
	hooksPath = ~/.config/git/hooks

[push]
	default = current
	followTags = true
	autoSetupRemote = true

[merge]
	tool = vimdiff
	path = nvim

[difftool]
	prompt = false
	tool = vimdiff
	path = nvim

[rerere]
	enabled = 1

[rebase]
	instructionFormat = (%an <%ae>) %s

[url "git@github.com:example-team/"]
	insteadOf = "is:"

[url "git@github.com:example-org/"]
  insteadof = "idx:"

[credential "https://github.com"]
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = !gh auth git-credential

[column]
	ui = auto

[branch]
	sort = -committerdate

[pull]
	rebase = true

[init]
	defaultBranch = main

[help]
	autocorrect = 10

[commit]
	template = ~/.config/git/hooks/commit.template
